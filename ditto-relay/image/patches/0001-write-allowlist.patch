+/**
+ * Parse a comma-separated list of pubkeys, accepting either 64-character hex
+ * keys or bech32 `npub` values. Used for operator-managed pubkey lists.
+ */
+function parsePubkeyList(name: string, value: string): Set<string> {
+  return new Set(
+    value
+      .split(",")
+      .map((entry) => entry.trim())
+      .filter((entry) => entry.length > 0)
+      .map((entry) => {
+        if (entry.toLowerCase().startsWith("npub1")) {
+          try {
+            const decoded = nip19.decode(entry);
+            if (decoded.type !== "npub") {
+              throw new Error("not an npub");
+            }
+            return decoded.data;
+          } catch {
+            throw new Error(`${name} contains an invalid npub: ${entry}`);
+          }
+        }
+
+        const hex = entry.toLowerCase();
+        if (!/^[0-9a-f]{64}$/.test(hex)) {
+          throw new Error(
+            `${name} entries must be npub or 64-character hex pubkeys; invalid entry: ${entry}`,
+          );
+        }
+        return hex;
+      }),
+  );
+}
