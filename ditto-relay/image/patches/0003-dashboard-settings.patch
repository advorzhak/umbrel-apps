+
+function stringArray(value: unknown): string[] | undefined {
+  return Array.isArray(value)
+    ? value.filter((entry): entry is string => typeof entry === "string")
+    : undefined;
+}
+
+function numberArray(value: unknown): number[] | undefined {
+  return Array.isArray(value)
+    ? value
+        .map((entry) => Number(entry))
+        .filter((entry) => Number.isInteger(entry))
+    : undefined;
+}
+
+async function applyDashboardSettings(): Promise<void> {
+  let raw: Record<string, unknown>;
+  try {
+    raw = JSON.parse(await readFile(settingsFile, "utf8")) as Record<
+      string,
+      unknown
+    >;
+  } catch {
+    return;
+  }
+
+  const allowed = stringArray(raw.writeAllowedPubkeys);
+  const rejected = numberArray(raw.rejectedKinds);
+  const banned = stringArray(raw.bannedHashtags);
+  const nsfw = stringArray(raw.nsfwHashtags);
+
+  relay.applyRuntimeSettings({
+    ...(allowed && {
+      writeAllowedPubkeys: new Set(
+        allowed.map((value) => value.toLowerCase()),
+      ),
+    }),
+    ...(rejected && { rejectedKinds: new Set(rejected) }),
+    ...(banned && {
+      bannedHashtags: new Set(banned.map((value) => value.toLowerCase())),
