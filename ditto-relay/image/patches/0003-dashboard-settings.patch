+// ---------------------------------------------------------------------------
+// Dashboard relay policy settings
+// ---------------------------------------------------------------------------
+
+interface SettingsFile {
+  writeAllowedPubkeys?: string[];
+  rejectedKinds?: number[];
+  bannedHashtags?: string[];
+  nsfwHashtags?: string[];
+  rejectNsfw?: boolean;
+  spamThreshold?: number;
+  maxFilterValues?: number;
+  maxLimit?: number;
+  defaultLimit?: number;
+}
+
+const settingsPath = `${config.syncDataDir}/settings.json`;
+
+function normalizePubkey(value: string): string | undefined {
+  const trimmed = value.trim().toLowerCase();
+  if (/^[0-9a-f]{64}$/.test(trimmed)) return trimmed;
+  if (!trimmed.startsWith("npub1")) return undefined;
+  try {
+    const decoded = nip19.decode(trimmed);
+    return decoded.type === "npub" ? decoded.data : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+async function effectiveSettings(): Promise<SettingsFile> {
+  const file = (await readJsonFile<SettingsFile>(settingsPath)) ?? {};
+  return {
+    writeAllowedPubkeys:
+      file.writeAllowedPubkeys ?? [...config.writeAllowedPubkeys],
+    rejectedKinds: file.rejectedKinds ?? [...config.rejectedKinds],
+    bannedHashtags: file.bannedHashtags ?? [...config.bannedHashtags],
+    nsfwHashtags: file.nsfwHashtags ?? [...config.nsfwHashtags],
+    rejectNsfw: file.rejectNsfw ?? config.rejectNsfw,
+    spamThreshold: file.spamThreshold ?? config.spamThreshold,
+    maxFilterValues: file.maxFilterValues ?? config.maxFilterValues,
+    maxLimit: file.maxLimit ?? config.maxLimit,
+    defaultLimit: file.defaultLimit ?? config.defaultLimit,
+  };
+}
+
+async function dashboardSettingsGet(): Promise<Response> {
+  return new Response(
+    JSON.stringify({
+      ...(await effectiveSettings()),
+      editable: config.dashboardPassword.length > 0,
+    }),
+    {
+      headers: {
+        "Content-Type": "application/json",
+        "Access-Control-Allow-Origin": "*",
+        "Cache-Control": "no-store",
+      },
+    },
+  );
+}
+
+async function dashboardSettingsPut(req: Request): Promise<Response> {
+  const headers = {
+    "Content-Type": "application/json",
+    "Access-Control-Allow-Origin": "*",
+    "Cache-Control": "no-store",
+  };
+
+  if (!config.dashboardPassword) {
+    return new Response(JSON.stringify({ error: "Dashboard is read-only" }), {
+      status: 403,
+      headers,
+    });
+  }
+
+  const auth = req.headers.get("authorization") ?? "";
+  const token = auth.startsWith("Bearer ") ? auth.slice(7).trim() : "";
+  if (!constantTimeEqual(token, config.dashboardPassword)) {
+    return new Response(JSON.stringify({ error: "Invalid password" }), {
+      status: 401,
+      headers,
+    });
+  }
+
+  let body: SettingsFile;
+  try {
+    body = (await req.json()) as SettingsFile;
+  } catch {
+    return new Response(JSON.stringify({ error: "Invalid JSON" }), {
+      status: 400,
+      headers,
+    });
+  }
+
+  const pubkeys: string[] = [];
+  for (const value of Array.isArray(body.writeAllowedPubkeys)
+    ? body.writeAllowedPubkeys
+    : []) {
+    const normalized = normalizePubkey(String(value));
+    if (!normalized) {
+      return new Response(
+        JSON.stringify({ error: `Invalid npub or hex pubkey: ${value}` }),
+        { status: 400, headers },
+      );
+    }
+    pubkeys.push(normalized);
+  }
+
+  const toNumbers = (value: unknown): number[] =>
+    Array.isArray(value)
+      ? value
+          .map((entry) => Number.parseInt(String(entry), 10))
+          .filter((entry) => Number.isInteger(entry) && entry >= 0)
+      : [];
+
+  const toTags = (value: unknown): string[] =>
+    Array.isArray(value)
+      ? value
+          .map((entry) => String(entry).trim().toLowerCase())
+          .filter(Boolean)
+      : [];
+
+  const positive = (value: unknown, fallback: number): number => {
+    const parsed = Number.parseInt(String(value ?? ""), 10);
+    return Number.isInteger(parsed) && parsed > 0 ? parsed : fallback;
+  };
+
+  const spamRaw = Number(body.spamThreshold);
+  const spamThreshold = Number.isFinite(spamRaw)
+    ? Math.min(1, Math.max(0, spamRaw))
+    : config.spamThreshold;
+
+  const maxFilterValues = positive(
+    body.maxFilterValues,
+    config.maxFilterValues,
+  );
+  const maxLimit = positive(body.maxLimit, config.maxLimit);
+  const defaultLimit = Math.min(
+    positive(body.defaultLimit, config.defaultLimit),
+    maxLimit,
+  );
+
+  const settings: SettingsFile = {
+    writeAllowedPubkeys: [...new Set(pubkeys)],
+    rejectedKinds: [...new Set(toNumbers(body.rejectedKinds))],
+    bannedHashtags: [...new Set(toTags(body.bannedHashtags))],
+    nsfwHashtags: [...new Set(toTags(body.nsfwHashtags))],
+    rejectNsfw: body.rejectNsfw === true,
+    spamThreshold,
+    maxFilterValues,
+    maxLimit,
+    defaultLimit,
+  };
+
+  try {
+    const { mkdir, rename, writeFile } = await import("node:fs/promises");
+    await mkdir(config.syncDataDir, { recursive: true });
+    const temporaryPath = `${settingsPath}.tmp`;
+    await writeFile(temporaryPath, `${JSON.stringify(settings, null, 2)}\n`);
+    await rename(temporaryPath, settingsPath);
+  } catch (error) {
+    log.error("dashboard_settings_write_failed", errFields(error));
+    return new Response(JSON.stringify({ error: "Could not write settings" }), {
+      status: 500,
+      headers,
+    });
+  }
+
+  // Keep NIP-11's advertised limits in step with what workers now enforce.
+  const limitation = relayInfo.limitation as
+    | (Record<string, unknown> & { max_limit?: number })
+    | undefined;
+  if (limitation) {
+    limitation.max_limit = maxLimit;
+    limitation.max_filter_values = maxFilterValues;
+    nip11Json = JSON.stringify(relayInfo, null, 2);
+  }
+
+  log.info("dashboard_settings_updated", {
+    allowedAuthors: settings.writeAllowedPubkeys?.length ?? 0,
+    rejectedKinds: settings.rejectedKinds?.length ?? 0,
+  });
+
+  return new Response(JSON.stringify({ ok: true, ...settings }), { headers });
+}
+
